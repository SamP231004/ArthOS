{
  "expo": {
    "name": "ArthOS",
    "slug": "arthos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arthos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.arthos.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06110c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arthos.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06110c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ArthOS reads payment screenshots you choose to add transactions for you.",
          "cameraPermission": "ArthOS can read a receipt you photograph to add the transaction for you."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "text/plain"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#a31c1b"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
            "./node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
            "./node_modules/@expo-google-fonts/newsreader/500Medium/Newsreader_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "SafeToSpend",
              "label": "Safe to spend",
              "description": "What you can spend today, from your budget",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional",
              "previewImage": "./assets/widget-preview/safe-to-spend.png"
            },
            {
              "name": "MonthSnapshot",
              "label": "Month snapshot",
              "description": "Budget left, spent and per-day for the rest of the month",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "480dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional",
              "previewImage": "./assets/widget-preview/month-snapshot.png"
            },
            {
              "name": "Portfolio",
              "label": "Portfolio",
              "description": "Value, 1-day and total returns, with a hide button",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional",
              "previewImage": "./assets/widget-preview/portfolio.png"
            },
            {
              "name": "QuickAdd",
              "label": "Quick add",
              "description": "One tap to add an expense or scan a screenshot",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional",
              "previewImage": "./assets/widget-preview/quick-add.png"
            }
          ]
        }
      ],
      "./plugins/with-local-gradle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bd048f8e-9c3d-48e6-a8f6-8ac97be6e09e"
      }
    },
    "owner": "samp231004"
  }
}
