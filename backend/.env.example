# Copy to your host's environment settings (Render / Railway / Fly). Never commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arthos?retryWrites=true&w=majority
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_HOURS=168
# Comma-separated; patterns allowed. Add your Vercel domain(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://arthos.vercel.app,https://*.vercel.app
# PORT is usually injected by the host.
